NODE_ENV=development
PORT=3000

# Database (Neon PostgreSQL)
DATABASE_URL=

# JWT Secrets
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Gemini AI
GEMINI_API_KEY=

# LeetCode 
LEETCODE_USERNAME=
LEETCODE_SESSION=
LEETCODE_CSRF=

# Redis (BullMQ job queues)
REDIS_URL=

# ChromaDB 
CHROMA_URL=http://localhost:8000
# Cloud: CHROMA_HOST + CHROMA_API_KEY + CHROMA_TENANT + CHROMA_DATABASE
CHROMA_HOST=
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# RAG reranking
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=5
